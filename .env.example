# ==========================================
# VARIABLES DE CONFIGURACIÓN - GesLab
# ==========================================
# Copia este archivo a .env y completa los valores
# NUNCA envíes .env a GitHub

# Puerto del Servidor
PUERTO=3000
NODE_ENV=development

# ==========================================
# BASE DE DATOS (REQUERIDA)
# ==========================================
# Formato: postgresql://usuario:password@host:puerto/nombre_db?schema=public
# Ejemplo: postgresql://postgres:password123@localhost:5432/geslab_db?schema=public
DATABASE_URL=

# ==========================================
# SEGURIDAD JWT (REQUERIDA)
# ==========================================
# Usar una cadena aleatoria larga y segura
# Ejemplo: openssl rand -base64 32
JWT_SECRETO=
JWT_EXPIRACION=8h

# ==========================================
# CORS
# ==========================================
CORS_ORIGEN=http://localhost:3000,http://localhost:5173

# ==========================================
# ARCHIVOS
# ==========================================
DIRECTORIO_SUBIDAS=uploads
TAMANO_MAXIMO_DOCUMENTO_MB=20
TAMANO_MAXIMO_EVIDENCIA_MB=100

# ==========================================
# ADMINISTRADOR INICIAL (Opcional)
# ==========================================
# Solo usado durante el seed inicial
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=GesLab
ADMIN_CORREO=admin@unicolmayor.edu.co
ADMIN_CONTRASENA=
