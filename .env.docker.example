# =================================================================
# VARIABLES DE CONFIGURACIÓN DOCKER COMPOSE - Ux
# =================================================================
# Copia este archivo a '.env' en la raíz de Ux para personalizar:
# cp .env.docker.example .env

# --- Puertos en el Equipo Anfitrión (Host) ---
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT=5432

# --- Base de Datos PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=Ux_db

# --- Seguridad y Tokens JWT Backend ---
JWT_SECRETO=clave_segura_jwt_Ux_2026_produccion
JWT_EXPIRACION=8h

# --- Configuración CORS ---
CORS_ORIGEN=http://localhost:8080,http://localhost:5173,http://localhost:3000

# --- URL de la API consumida por el Frontend Web ---
# En Docker, /api aprovecha el proxy inverso de Nginx al contenedor backend
VITE_API_URL=/api

# --- Administrador del Sistema para Seeding Inicial ---
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Ux
ADMIN_CORREO=admin@unicolmayor.edu.co
# OBLIGATORIO. Contraseña inicial del administrador (cámbiala tras el primer ingreso)
ADMIN_CONTRASENA=

# Solo para desarrollo: crea usuarios de ejemplo (docente, estudiante, encargado)
SEMBRAR_USUARIOS_DEMO=false
